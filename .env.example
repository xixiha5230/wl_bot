# Wi-Fi credentials loaded by the firmware build (main/CMakeLists.txt).
# Copy this file to .env and fill in your own values. .env is git-ignored.
#
# Station mode (home router):
WLROBOT_WIFI_SSID=your-ssid
WLROBOT_WIFI_PASSWORD=your-password

# Fallback AP (optional; defaults are in main/wifi_net.c):
# WLROBOT_AP_SSID=WLROBOT
# WLROBOT_AP_PASSWORD=12345678
